# Cognito User Pool public configuration (never put secrets here)
VITE_COGNITO_USER_POOL_ID=replace-with-user-pool-id
VITE_COGNITO_USER_POOL_CLIENT_ID=replace-with-user-pool-client-id

# CampusMeet HTTP API base URL
VITE_API_BASE_URL=https://replace-with-api-id.execute-api.region.amazonaws.com

# Numeric Google Cloud project number used by the Meet Add-ons SDK
VITE_GOOGLE_CLOUD_PROJECT_NUMBER=123456789012
