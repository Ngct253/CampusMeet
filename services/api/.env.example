ENVIRONMENT=local
LOG_LEVEL=info
GOOGLE_SECRET_REFERENCE=replace-with-secret-reference
AWS_REGION=ap-southeast-1
IDENTITY_TABLE=campusmeet-dev-identity
COLLABORATION_TABLE=campusmeet-dev-collaboration
MEETING_DATA_TABLE=campusmeet-dev-meeting-data
TASK_DATA_TABLE=campusmeet-dev-task-data
AI_WORK_TABLE=campusmeet-dev-ai-work
USER_CONTENT_BUCKET=replace-with-m4-user-content-bucket
AI_STATE_MACHINE_ARN=arn:aws:states:ap-southeast-1:123456789012:stateMachine:campusmeet-dev-ai-jobs
REMINDER_FUNCTION_ARN=arn:aws:lambda:ap-southeast-1:123456789012:function:campusmeet-dev-reminder
SCHEDULER_EXECUTION_ROLE_ARN=arn:aws:iam::123456789012:role/campusmeet-dev-scheduler
SES_FROM_EMAIL=notifications@example.com
SES_CONFIGURATION_SET=campusmeet-dev-email-events
